{
  "name": "@local/dsh-session-skills",
  "version": "1.0.1",
  "private": true,
  "description": "Session-only multi-select skill picker for the DeepSeek Harness composer.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "Install.ps1", "README.md", "THIRD-PARTY-NOTICES.txt"],
  "scripts": { "test": "node --test tests/*.test.cjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-skill"]
    }
  }
}
